{
  "info": {
    "name": "FrameYaad Backend - Auth, Users, Employees",
    "description": "Phase 1 authentication and RBAC APIs. Postman automatically retains the HttpOnly auth cookies returned by login. Run the requests in role order because each login replaces the active cookie session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "cleanBaseUrl", "value": "http://127.0.0.1:5000/api/v1" },
    { "key": "customerEmail", "value": "customer@example.com" },
    { "key": "customerPassword", "value": "CustomerPassword1" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "AdminPassword1" },
    { "key": "employeeEmail", "value": "employee@example.com" },
    { "key": "employeePassword", "value": "EmployeePassword1" },
    { "key": "customerId", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "materialId", "value": "PASTE_ACTIVE_MATERIAL_UUID" },
    { "key": "variantId", "value": "PASTE_ACTIVE_VARIANT_UUID" },
    { "key": "productId", "value": "" },
    { "key": "productIdentifier", "value": "FRAME-001" },
    { "key": "addressId", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "wishlistId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "recoveryAccessToken", "value": "" },
    { "key": "recoveryRefreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Security Checks",
      "description": "Uses 127.0.0.1 so cookies stored for localhost are not sent. This proves admin APIs reject a clean unauthenticated client.",
      "item": [
        {
          "name": "Create Employee Without Any Session - Must Fail",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Unauthorized Employee\",\n  \"email\": \"unauthorized@example.com\",\n  \"password\": \"UnauthorizedPassword1\"\n}" },
            "url": "{{cleanBaseUrl}}/employees"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unauthenticated request is rejected', () => pm.response.to.have.status(401));", "pm.test('Correct error code', () => pm.expect(pm.response.json().error.code).to.eql('AUTHENTICATION_REQUIRED'));"] } }]
        }
      ]
    },
    {
      "name": "Bootstrap and Customer Auth",
      "item": [
        {
          "name": "Register First Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"FrameYaad Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/admin/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Admin created', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"phoneNumber\": \"+919999999999\"\n}" },
            "url": "{{baseUrl}}/auth/customer/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Customer created', () => pm.response.to.have.status(201));", "const json = pm.response.json(); if (json.data?.user?.id) pm.collectionVariables.set('customerId', json.data.user.id);"] } }]
        },
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/customer/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Customer logged in', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get My Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Profile returned', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Customer\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\"\n}" },
            "url": "{{baseUrl}}/auth/profile"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Profile updated', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Change Password with Old Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{customerPassword}}\",\n  \"newPassword\": \"CustomerPassword2\"\n}" },
            "url": "{{baseUrl}}/auth/change-password"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Password changed', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Password Recovery (All Roles)",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\"\n}" },
            "url": "{{baseUrl}}/auth/forgot-password"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reset request accepted', () => pm.response.to.have.status(202));"] } }]
        },
        {
          "name": "Reset Password from Recovery Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accessToken\": \"{{recoveryAccessToken}}\",\n  \"refreshToken\": \"{{recoveryRefreshToken}}\",\n  \"newPassword\": \"RecoveredPassword1\"\n}" },
            "url": "{{baseUrl}}/auth/reset-password"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Password reset', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Customer Addresses",
      "description": "A customer-owned address is required before cart checkout.",
      "item": [
        {
          "name": "Create Address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"addressLine\": \"Flat 10, Main Road\",\n  \"postalCode\": \"411001\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"contactPerson\": \"Test Customer\",\n  \"contactNumber\": \"+919999999999\"\n}" },
            "url": "{{baseUrl}}/addresses"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Address created', () => pm.response.to.have.status(201));", "const json = pm.response.json(); if (json.data?.address?.id) pm.collectionVariables.set('addressId', json.data.address.id);"] } }]
        },
        {
          "name": "List My Addresses",
          "request": { "method": "GET", "url": "{{baseUrl}}/addresses" }
        },
        {
          "name": "Update My Address",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"addressLine\": \"Flat 11, Main Road\"\n}" },
            "url": "{{baseUrl}}/addresses/{{addressId}}"
          }
        }
      ]
    },
    {
      "name": "Customer Cart",
      "description": "Only a CUSTOMER session can access these endpoints. Prices are loaded from the product variant by the backend.",
      "item": [
        {
          "name": "Get My Cart",
          "request": { "method": "GET", "url": "{{baseUrl}}/cart" }
        },
        {
          "name": "Add Product to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productIdentifier\": \"{{productIdentifier}}\",\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/cart/items"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Cart item added', () => pm.response.to.have.status(201));", "const json = pm.response.json(); const item = json.data?.cart?.items?.find(i => i.productIdentifier === pm.collectionVariables.get('productIdentifier')); if (item?.id) pm.collectionVariables.set('cartItemId', item.id);"] } }]
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": "{{baseUrl}}/cart/items/{{cartItemId}}"
          }
        },
        {
          "name": "Remove Cart Item",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/cart/items/{{cartItemId}}" }
        },
        {
          "name": "Clear Cart",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/cart" }
        }
      ]
    },
    {
      "name": "Orders",
      "description": "Checkout is customer-only. Customers see their orders; admins/employees see all and control status. Add an item again if you used Remove/Clear Cart.",
      "item": [
        {
          "name": "Checkout Cart - Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userAddressId\": \"{{addressId}}\",\n  \"remark\": \"Handle with care\"\n}" },
            "url": "{{baseUrl}}/orders/checkout"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Order created', () => pm.response.to.have.status(201));", "const json = pm.response.json(); if (json.data?.order?.id) pm.collectionVariables.set('orderId', json.data.order.id);"] } }]
        },
        {
          "name": "List Orders - Role Scoped",
          "request": { "method": "GET", "url": "{{baseUrl}}/orders?page=1&limit=20" }
        },
        {
          "name": "Get Order - Role Scoped",
          "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderId}}" }
        },
        {
          "name": "Confirm Order - Admin or Employee",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"remark\": \"Order confirmed\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Process Order - Admin or Employee",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PROCESSING\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/status"
          }
        }
      ]
    },
    {
      "name": "Customer Wishlist",
      "description": "Customer-only endpoints. The backend always uses the authenticated customer id and never accepts a user id from the request.",
      "item": [
        {
          "name": "Add Product to My Wishlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productIdentifier\": \"{{productIdentifier}}\"\n}" },
            "url": "{{baseUrl}}/wishlist"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Wishlist item added', () => pm.response.to.have.status(201));", "const json = pm.response.json(); if (json.data?.wishlistItem?.id) pm.collectionVariables.set('wishlistId', json.data.wishlistItem.id);"] } }]
        },
        {
          "name": "List My Wishlist",
          "request": { "method": "GET", "url": "{{baseUrl}}/wishlist" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Owned wishlist returned', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Remove Product from My Wishlist",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/wishlist/{{wishlistId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Wishlist item removed', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    },
    {
      "name": "Notifications",
      "description": "Customers see private notices. Admins and employees share the operational feed. Marking a staff notice read returns the first reader in readBy; employees cannot delete shared notices.",
      "item": [
        {
          "name": "List My Notifications",
          "request": { "method": "GET", "url": "{{baseUrl}}/notifications?page=1&limit=20" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Notifications returned', () => pm.response.to.have.status(200));", "const json = pm.response.json(); const notification = json.data?.notifications?.[0]; if (notification?.id) pm.collectionVariables.set('notificationId', notification.id);"] } }]
        },
        {
          "name": "List Unread Order Notifications",
          "request": { "method": "GET", "url": "{{baseUrl}}/notifications?page=1&limit=20&read=false&type=ORDER_PLACED" }
        },
        {
          "name": "Get My Unread Count",
          "request": { "method": "GET", "url": "{{baseUrl}}/notifications/unread-count" }
        },
        {
          "name": "Mark One Notification Read - Check readBy",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/notifications/{{notificationId}}/read" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Notification marked read', () => pm.response.to.have.status(200));", "pm.test('Reader identity is returned', () => pm.expect(pm.response.json().data.notification.readBy).to.be.an('object'));"] } }]
        },
        {
          "name": "Mark All My Notifications Read",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/notifications/read-all" }
        },
        {
          "name": "Delete Notification - Customer Owner or Admin Only",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/notifications/{{notificationId}}" }
        }
      ]
    },
    {
      "name": "Products",
      "description": "GET requests accept customer, employee, or admin sessions. POST/PATCH/DELETE require employee or admin. Set materialId and variantId to existing active records before creating a product.",
      "item": [
        {
          "name": "List Products - Any Authenticated Role",
          "request": { "method": "GET", "url": "{{baseUrl}}/products?page=1&limit=20&search=" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Authenticated product list succeeds', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get Product - Any Authenticated Role",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }
        },
        {
          "name": "Create Product - Admin or Employee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"materialId\": \"{{materialId}}\",\n  \"variantId\": \"{{variantId}}\",\n  \"productIdentifier\": \"FRAME-001\",\n  \"productName\": \"Classic Frame\"\n}" },
            "url": "{{baseUrl}}/products"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Product created', () => pm.response.to.have.status(201));", "const json = pm.response.json(); if (json.data?.product?.id) pm.collectionVariables.set('productId', json.data.product.id);"] } }]
        },
        {
          "name": "Update Product - Admin or Employee",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productName\": \"Updated Classic Frame\"\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Delete Product - Admin or Employee",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Product deleted', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    },
    {
      "name": "Admin - Customers",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/admin/login"
          }
        },
        {
          "name": "List Customers",
          "request": { "method": "GET", "url": "{{baseUrl}}/users?page=1&limit=20" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Customers returned', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get Customer",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/{{customerId}}" }
        },
        {
          "name": "Update or Deactivate Customer",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": "{{baseUrl}}/users/{{customerId}}"
          }
        }
      ]
    },
    {
      "name": "Admin - Employees",
      "item": [
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Employee\",\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\"\n}" },
            "url": "{{baseUrl}}/employees"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Employee created', () => pm.response.to.have.status(201));", "const json = pm.response.json(); if (json.data?.employee?.id) pm.collectionVariables.set('employeeId', json.data.employee.id);"] } }]
        },
        {
          "name": "List Employees",
          "request": { "method": "GET", "url": "{{baseUrl}}/employees?page=1&limit=20" }
        },
        {
          "name": "Get Employee",
          "request": { "method": "GET", "url": "{{baseUrl}}/employees/{{employeeId}}" }
        },
        {
          "name": "Update Employee as Admin",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"city\": \"Mumbai\"\n}" },
            "url": "{{baseUrl}}/employees/{{employeeId}}"
          }
        },
        {
          "name": "Employee Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/employee/login"
          }
        },
        {
          "name": "Employee View Own Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Employee Update Own Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Employee\",\n  \"city\": \"Pune\"\n}" },
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Employee Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{employeePassword}}\",\n  \"newPassword\": \"EmployeePassword2\"\n}" },
            "url": "{{baseUrl}}/auth/change-password"
          }
        },
        {
          "name": "Employee Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{employeeEmail}}\"\n}" },
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    }
  ]
}
